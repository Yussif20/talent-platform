{
  "openapi": "3.0.1",
  "info": {
    "title": "TalentBridge",
    "version": "1.0"
  },
  "paths": {
    "/api/Reports/summary": {
      "get": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Reports/export-excel": {
      "get": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/SurveyResult/Save": {
      "post": {
        "tags": [
          "SurveyResult"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SurveyResultInputDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SurveyResultInputDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SurveyResultInputDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/SurveyResult/Satisfaction/Save": {
      "post": {
        "tags": [
          "SurveyResult"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SatisfactionInputDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SatisfactionInputDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SatisfactionInputDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SatisfactionInputDto": {
        "type": "object",
        "properties": {
          "surveyId": {
            "type": "string",
            "format": "uuid"
          },
          "satisfactionPercent": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SurveyResultInputDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "educationGrade": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "parentName": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "checkerName": {
            "type": "string",
            "nullable": true
          },
          "checkupDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "schoolName": {
            "type": "string",
            "nullable": true
          },
          "isTalented": {
            "type": "boolean"
          },
          "talentPercent": {
            "type": "number",
            "format": "double"
          },
          "isDisabled": {
            "type": "boolean",
            "nullable": true
          },
          "disability": {
            "type": "string",
            "nullable": true
          },
          "disabilityPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "satisfactionPercent": {
            "type": "number",
            "format": "double"
          },
          "surveyType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
