# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
build/
dist/

# turbo
.turbo/

# production
*.tsbuildinfo
next-env.d.ts

# env — never commit real keys
.env
.env*.local
.env.production

# supabase local stack
supabase/.branches/
supabase/.temp/
supabase/.env

# testing
coverage/

# misc
.DS_Store
*.pem
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# vercel
.vercel

# Nested lockfiles. npm workspaces resolve from the root lockfile only; a stray one in
# an app directory makes Vercel install that app's stale dependency tree instead of the
# workspace, which silently omits the @talent/* packages and @supabase/ssr. Two arrived
# with the git subtree import and crashed the deployed middleware.
apps/*/package-lock.json
packages/*/package-lock.json
