# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings -> API). See SETUP.md.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to expose in the browser: row-level security bounds it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. BYPASSES row-level security. Server-side and seeding only --
# never expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the forms app, used for report links in outgoing email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for emailing reports. Optional; email is skipped when unset.
RESEND_API_KEY=
